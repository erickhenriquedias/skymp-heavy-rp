PANEL_PORT=3001
# URL publica do painel. Em producao troque pelo dominio real — ela define a
# origem aceita no CORS e o fallback do callback do Discord. Aceita lista
# separada por virgula (ex: apex + www).
PANEL_PUBLIC_URL=http://localhost:3001

# `production` liga cookie de sessao `secure` e o trust proxy (ver TRUST_PROXY).
NODE_ENV=development

# Ligue atras de reverse proxy (nginx, Cloudflare, Traefik). Sem isso o Express
# enxerga o IP do proxy em vez do IP do jogador, e o rate limit passa a contar
# o mundo inteiro como um visitante so — o limitador continua "funcionando" e
# nao protege nada. `NODE_ENV=production` ja liga isto sozinho.
TRUST_PROXY=false

# Allowlist dos redirect_uri aceitos em POST /api/launcher/oauth/exchange —
# a rota que troca o `code` do Discord pelo perfil (o client secret vive so
# aqui, nunca no launcher; ver achado 2.2 do QA_REPORT). O default cobre o
# servidor de callback local do launcher (127.0.0.1:19847, ver
# apps/launcher/electron/main.ts); so mexa se mudar essa porta.
LAUNCHER_REDIRECT_URIS=http://localhost:19847/callback,http://127.0.0.1:19847/callback

# Rotacao dos crash reports do launcher. Sem limite o diretorio cresce pra
# sempre: cada relatorio carrega ate 64 KB de log por crash.
CRASH_REPORT_MAX_FILES=500
CRASH_REPORT_MAX_AGE_DAYS=30
SESSION_SECRET=
INTERNAL_API_SECRET=
# Onde o bot do Discord expoe a API interna de sync de cargo (PORT no .env do bot).
BOT_INTERNAL_URL=http://127.0.0.1:3002
# A master API confirma aqui que a sessão resolvida passou a ocupar um slot.
# Se a game-api não confirmar, o login online falha fechado com HTTP 503.
GAME_API_INTERNAL_URL=http://127.0.0.1:7758
# Quanto tempo uma confirmacao de cargo Discord vale sem nova consulta. Eventos
# do bot revogam antes; o TTL e o fail-safe caso o evento nao chegue.
DISCORD_ROLE_ACCESS_TTL_SECONDS=43200

# Identifica o servidor de jogo no contrato de master API do SkyMP. PRECISA
# bater com "masterKey" do skymp/config/server-settings.*.json. Sem isso o
# endpoint /api/servers/:masterKey/sessions/:session responde 404 sempre, e o
# servidor volta a depender do profileId que o cliente informa.
MASTER_KEY=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_CALLBACK_URL=http://localhost:3001/api/auth/discord/callback
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASS=
DB_NAME=skymp_rp
