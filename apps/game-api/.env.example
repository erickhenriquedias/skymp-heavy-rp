# Porta que o launcher chama (VITE_API_PORT no .env do launcher).
GAME_API_PORT=7758
# 0.0.0.0 porque jogadores conectam de fora. Use firewall pra restringir.
GAME_API_BIND_HOST=0.0.0.0

# Capacidade de slots. Acima disso, jogadores entram na fila.
QUEUE_CAPACITY=40

# Recusa join/status antes de consumir o ticket do jogador. `/health` continua
# 200 (processo vivo) e `/ready` responde 503 enquanto a manutenção estiver ativa.
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE=Servidor em manutenção. Tente novamente em breve.

# Validade maxima da sessao ainda nao resolvida. Cada token do master e de uso
# unico; depois de uma queda, o launcher solicita uma sessao nova.
GAME_SESSION_TTL_SECONDS=43200

# Retencao de credenciais expiradas no MariaDB. A limpeza roda no boot e,
# havendo trafego de fila, no maximo uma vez a cada 15 minutos. Cada rodada
# remove ate 10 lotes de 500 linhas por tabela para nao monopolizar o banco.
LAUNCH_TICKET_RETENTION_SECONDS=86400
GAME_SESSION_RETENTION_SECONDS=604800
CREDENTIAL_CLEANUP_INTERVAL_SECONDS=900
CREDENTIAL_CLEANUP_BATCH_SIZE=500
CREDENTIAL_CLEANUP_MAX_BATCHES=10

# Caminho do manifesto de paridade gerado por scripts/generate-mods-manifest.js.
MODS_MANIFEST_PATH=./mods.json
# Mesmo mapa JSON de chaves PUBLICAS Ed25519 pinado no launcher. A game-api
# recusa manifesto v2 ausente, expirado, adulterado ou assinado por outra chave.
MODS_MANIFEST_PUBLIC_KEYS={"release-2026":"COLE_A_CHAVE_PUBLICA_SPKI_BASE64"}

# Mesmo segredo do apps/web e apps/bot-discord — protege /internal/*.
INTERNAL_API_SECRET=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASS=
DB_NAME=skymp_rp
