diff --git a/skymp5-client/src/features/authModel.ts b/skymp5-client/src/features/authModel.ts
index 55425e2..a8d0aa0 100644
--- a/skymp5-client/src/features/authModel.ts
+++ b/skymp5-client/src/features/authModel.ts
@@ -16,3 +16,40 @@ export interface AuthGameData {
 };
 
 export const authGameDataStorageKey = "authGameData";
+
+const minExternalSessionLength = 32;
+const maxExternalSessionLength = 512;
+
+export function getAuthGameDataFromSettings(settingsGameData: unknown): AuthGameData | null {
+  if (!settingsGameData || typeof settingsGameData !== "object") {
+    return null;
+  }
+
+  const candidate = settingsGameData as Record<string, unknown>;
+  const session = candidate.session;
+
+  // Prefer a server-resolved session over profileId when both are present.
+  // A stale profileId must never downgrade an online launch to offline auth.
+  if (
+    typeof session === "string" &&
+    session.length >= minExternalSessionLength &&
+    session.length <= maxExternalSessionLength &&
+    !/\s/.test(session)
+  ) {
+    return {
+      remote: {
+        session,
+        masterApiId: 0,
+        discordUsername: null,
+        discordDiscriminator: null,
+        discordAvatar: null,
+      },
+    };
+  }
+
+  if (Number.isInteger(candidate.profileId)) {
+    return { local: { profileId: candidate.profileId as number } };
+  }
+
+  return null;
+}
