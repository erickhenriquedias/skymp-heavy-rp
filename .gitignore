references/
node_modules/
apps/*/node_modules/

# Segredos de runtime. Os .env.example ficam versionados (whitelist abaixo);
# qualquer .env real carrega SESSION_SECRET, DISCORD_CLIENT_SECRET, DB_PASS
# e DISCORD_BOT_TOKEN — nunca pode entrar no repositorio.
.env
.env.*
!.env.example

# Build do helper nativo. O `cmake -B build` cria isto, e com o vcpkg em modo
# manifesto ele carrega tambem as dependencias compiladas (`vcpkg_installed/`) —
# centenas de MB de artefato de maquina, nada versionavel.
voice-helper/build/
voice-helper/vcpkg_installed/

# Andaime de teste da voz (VOIP_DEBUG_EXPOSE_TICKET). Contem um ticket de voz em
# texto puro — vale 30s e autentica como aquele jogador. E gerado so quando a
# flag e ligada a mao durante teste manual, e some com a Fase 3.
# Ver docs/technical/VOICE_NATIVE_HELPER.md §11.
skymp/gamemode/.voip-debug-ticket.json

# Saida de ferramenta de agente, nao conteudo do projeto. Fica vazia no disco, e
# diretorio vazio o git nao mostra — entra sem aviso no primeiro `git add -A`
# depois que um arquivo cair ali. O que e do projeto mora em `.agents/`.
generated-images/

skymp/server/
skymp/artifacts/
skymp/client-backups/
skymp/data/
skymp/world/
skymp/*.log
skymp/config/server-settings.local.json
skymp/config/server-settings.staging.json
skymp/config/server-settings.production.json
skymp/config/server-options.local.json
skymp/config/server-options.staging.json
skymp/config/server-options.production.json
skymp/config/npc-policy.json
skymp/config/safe-zones.json
skymp/config/database.local.json
skymp/config/database.staging.json
skymp/config/database.production.json
skymp/config/secrets.*
*.zip
*.7z
*.rar

# Chave privada Ed25519 gerada pelo tooling de release. A chave publica pode
# ser versionada/documentada; o PKCS8 privado nunca entra no repositorio.
*.update-signing.pk8.base64
